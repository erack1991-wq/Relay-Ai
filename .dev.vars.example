# Copy to .dev.vars for local development. Never commit the real file.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"
PUBLIC_BASE_URL="https://your-public-https-tunnel.example"
OPENAI_API_KEY="sk-..."
OPENAI_VOICE_MODEL="gpt-5-mini"
# Stripe test-mode values for local checkout/webhook development.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PRICE_ID="price_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Optional OpenAI-compatible backup provider. Leave unset to use the primary only.
AI_BACKUP_API_KEY=""
AI_BACKUP_BASE_URL=""
AI_BACKUP_MODEL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-public-domain.example/api/google-calendar/callback"
# Base64-encoded 32-byte key. Generate one for production and keep it secret.
GOOGLE_TOKEN_ENCRYPTION_KEY=""
RELAY_GREETING="Thanks for calling. What service do you need today?"
